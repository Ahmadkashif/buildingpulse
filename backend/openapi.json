{
  "components": {
    "schemas": {
      "CreateBuildingInput": {
        "additionalProperties": false,
        "properties": {
          "borough": {
            "enum": [
              "manhattan",
              "brooklyn",
              "queens",
              "bronx",
              "staten-island"
            ],
            "title": "Borough",
            "type": "string"
          },
          "grossFloorAreaSqft": {
            "maximum": 5000000.0,
            "minimum": 500.0,
            "title": "Grossfloorareasqft",
            "type": "integer"
          },
          "numberOfBuildings": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Numberofbuildings",
            "type": "integer"
          },
          "propertyType": {
            "enum": [
              "multifamily-housing",
              "office",
              "hotel",
              "retail",
              "hospital",
              "mixed-use"
            ],
            "title": "Propertytype",
            "type": "string"
          },
          "yearBuilt": {
            "maximum": 2026.0,
            "minimum": 1800.0,
            "title": "Yearbuilt",
            "type": "integer"
          }
        },
        "required": [
          "propertyType",
          "borough",
          "grossFloorAreaSqft",
          "yearBuilt",
          "numberOfBuildings"
        ],
        "title": "CreateBuildingInput",
        "type": "object"
      },
      "FineYear": {
        "additionalProperties": false,
        "properties": {
          "projectedAnnualFineUsd": {
            "title": "Projectedannualfineusd",
            "type": "number"
          },
          "year": {
            "maximum": 2034.0,
            "minimum": 2024.0,
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year",
          "projectedAnnualFineUsd"
        ],
        "title": "FineYear",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LL97": {
        "additionalProperties": false,
        "properties": {
          "atRisk": {
            "title": "Atrisk",
            "type": "boolean"
          },
          "capKbtuPerSqft2024To2029": {
            "title": "Capkbtupersqft2024To2029",
            "type": "number"
          },
          "capKbtuPerSqft2030To2034": {
            "title": "Capkbtupersqft2030To2034",
            "type": "number"
          },
          "fineSeries": {
            "items": {
              "$ref": "#/components/schemas/FineYear"
            },
            "minItems": 1,
            "title": "Fineseries",
            "type": "array"
          },
          "projectedAnnualFineUsd2024": {
            "title": "Projectedannualfineusd2024",
            "type": "number"
          },
          "projectedAnnualFineUsd2030": {
            "title": "Projectedannualfineusd2030",
            "type": "number"
          }
        },
        "required": [
          "capKbtuPerSqft2024To2029",
          "capKbtuPerSqft2030To2034",
          "projectedAnnualFineUsd2024",
          "projectedAnnualFineUsd2030",
          "atRisk",
          "fineSeries"
        ],
        "title": "LL97",
        "type": "object"
      },
      "Peer": {
        "additionalProperties": false,
        "properties": {
          "cohort": {
            "$ref": "#/components/schemas/PeerCohort"
          },
          "cohortSize": {
            "minimum": 0.0,
            "title": "Cohortsize",
            "type": "integer"
          },
          "medianSiteEui": {
            "title": "Mediansiteeui",
            "type": "number"
          },
          "p25SiteEui": {
            "title": "P25Siteeui",
            "type": "number"
          },
          "p75SiteEui": {
            "title": "P75Siteeui",
            "type": "number"
          },
          "percentile": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Percentile",
            "type": "integer"
          }
        },
        "required": [
          "cohort",
          "cohortSize",
          "medianSiteEui",
          "p25SiteEui",
          "p75SiteEui",
          "percentile"
        ],
        "title": "Peer",
        "type": "object"
      },
      "PeerCohort": {
        "additionalProperties": false,
        "properties": {
          "ageBand": {
            "anyOf": [
              {
                "enum": [
                  "pre-1950",
                  "1950-1979",
                  "1980-1999",
                  "2000-plus"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ageband"
          },
          "borough": {
            "anyOf": [
              {
                "enum": [
                  "manhattan",
                  "brooklyn",
                  "queens",
                  "bronx",
                  "staten-island"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Borough"
          },
          "propertyType": {
            "enum": [
              "multifamily-housing",
              "office",
              "hotel",
              "retail",
              "hospital",
              "mixed-use"
            ],
            "title": "Propertytype",
            "type": "string"
          }
        },
        "required": [
          "propertyType",
          "borough",
          "ageBand"
        ],
        "title": "PeerCohort",
        "type": "object"
      },
      "Prediction": {
        "additionalProperties": false,
        "properties": {
          "intervalHigh": {
            "title": "Intervalhigh",
            "type": "number"
          },
          "intervalLow": {
            "title": "Intervallow",
            "type": "number"
          },
          "modelVersion": {
            "minLength": 1,
            "title": "Modelversion",
            "type": "string"
          },
          "siteEuiKbtuPerSqft": {
            "title": "Siteeuikbtupersqft",
            "type": "number"
          }
        },
        "required": [
          "siteEuiKbtuPerSqft",
          "intervalLow",
          "intervalHigh",
          "modelVersion"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "PredictionResponse": {
        "additionalProperties": false,
        "properties": {
          "generatedAt": {
            "format": "date-time",
            "title": "Generatedat",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/CreateBuildingInput"
          },
          "ll97": {
            "$ref": "#/components/schemas/LL97"
          },
          "peer": {
            "$ref": "#/components/schemas/Peer"
          },
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          }
        },
        "required": [
          "id",
          "generatedAt",
          "input",
          "prediction",
          "peer",
          "ll97"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "PredictionResponseEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PredictionResponse"
          }
        },
        "required": [
          "data"
        ],
        "title": "PredictionResponseEnvelope",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BuildingPulse API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/predictions": {
      "post": {
        "operationId": "create_api_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBuildingInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponseEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create"
      }
    }
  }
}
